{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "suiteId", "instanceId", "endpoint", "credential", "capabilities"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "suiteId": { "type": "string", "minLength": 1 },
    "instanceId": { "type": "string", "minLength": 1 },
    "endpoint": { "type": "object" },
    "credential": {
      "type": "object",
      "required": ["tokenPath"],
      "properties": { "tokenPath": { "type": "string", "minLength": 1 } }
    },
    "capabilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  }
}

